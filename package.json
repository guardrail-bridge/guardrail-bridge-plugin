{
  "name": "@guardrailbridge/guardrail-bridge",
  "version": "1.0.4",
  "private": false,
  "description": "Guardrail plugin for OpenClaw that blocks prompt injection, jailbreak attempts, and sensitive credential exfiltration before agent dispatch.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "guardrail",
    "guardrails",
    "guardrail-bridge",
    "guardrailbridge",
    "openclaw",
    "openclaw-plugin",
    "openclaw-security",
    "openclaw-guardrail",
    "clawhub",
    "agent-security",
    "ai-agent-security",
    "ai-agent",
    "prompt-injection",
    "jailbreak-detection",
    "credential-protection",
    "api-key-protection",
    "tool-call-security",
    "policy-enforcement",
    "content-moderation",
    "security",
    "audit",
    "typescript"
  ],
  "homepage": "https://github.com/guardrail-bridge/guardrail-bridge-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guardrail-bridge/guardrail-bridge-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/guardrail-bridge/guardrail-bridge-plugin/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./api": "./dist/api.js"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "assets/",
    "README-zh.md",
    "docs/README.md",
    "docs/README-zh.md",
    "docs/usage.md",
    "docs/usage-zh.md",
    "docs/case-study-api-key-leakage.md",
    "docs/manifest-schema.md",
    "docs/manifest-schema-zh.md",
    "docs/security-notes.md",
    "docs/security-notes-zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.26"
  },
  "dependencies": {
    "@monyone/aho-corasick": "^1.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "^2026.4.26",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@guardrailbridge/guardrail-bridge",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.26"
    },
    "compat": {
      "pluginApi": ">=2026.4.26"
    },
    "build": {
      "openclawVersion": "2026.4.26"
    },
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
